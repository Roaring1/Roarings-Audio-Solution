# /home/roaring/.config/systemd/user/roaring-moonlight-mic.service
[Unit]
Description=Roaring mic passthrough → Windows (Moonlight host) via UDP
After=pipewire.service pipewire-pulse.service wireplumber.service roaring-mic-busses.service
Wants=pipewire-pulse.service wireplumber.service roaring-mic-busses.service
StartLimitIntervalSec=60
StartLimitBurst=10

[Service]
Type=simple
Environment=MOONLIGHT_HOST_IP=192.168.50.132
Environment=MIC_SOURCE=b1_mic
Environment=MIC_PORT=46001
ExecStart=/bin/bash %h/bin/roaring_moonlight_micd.sh
Restart=on-failure
RestartSec=3
TimeoutStartSec=30

[Install]
WantedBy=default.target
